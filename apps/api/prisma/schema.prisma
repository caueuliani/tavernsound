// apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================
// 👤 USUÁRIOS E AUTENTICAÇÃO
// ====================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  avatarUrl     String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  
  // Relações
  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  ownedRooms    Room[]    @relation("RoomOwner")
  roomMembers   RoomMember[]
  diceRolls     DiceRoll[]
  
  @@index([email])
}

// NextAuth: Contas (Google, GitHub, etc)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// NextAuth: Sessões
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// NextAuth: Tokens de verificação
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ====================================
// 💳 ASSINATURAS E PAGAMENTOS
// ====================================

enum SubscriptionTier {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  EXPIRED
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tier            SubscriptionTier   @default(FREE)
  status          SubscriptionStatus @default(ACTIVE)
  
  startDate       DateTime           @default(now())
  endDate         DateTime?
  trialEndsAt     DateTime?
  canceledAt      DateTime?
  
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  
  couponCode      String?
  discountPercent Int?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  invoices        Invoice[]
  
  @@index([userId])
  @@index([status])
}

model Invoice {
  id              String   @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  amount          Int
  currency        String   @default("USD")
  status          String
  
  stripeInvoiceId String?  @unique
  pdfUrl          String?
  
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  
  @@index([subscriptionId])
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int
  maxUses         Int?
  currentUses     Int      @default(0)
  
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  
  @@index([code])
}

// ====================================
// 🏠 SALAS (ROOMS)
// ====================================

model Room {
  id          String   @id
  name        String?  @default("Sala sem nome")
  ownerId     String?
  owner       User?    @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  
  mapUrl      String?
  gridSize    Int      @default(50)
  mapWidth    Int      @default(20)
  mapHeight   Int      @default(20)
  
  fogOfWarData Json?
  
  isPublic    Boolean  @default(false)
  password    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastActiveAt DateTime @default(now())
  
  tokens      Token[]
  members     RoomMember[]
  diceRolls   DiceRoll[]
  
  @@index([ownerId])
  @@index([lastActiveAt])
}

model RoomMember {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  nickname  String
  color     String   @default("#3B82F6")
  
  role      String   @default("PLAYER")
  
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  
  @@index([roomId])
  @@index([userId])
}

// ====================================
// 🎭 TOKENS
// ====================================

model Token {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  name        String
  x           Int
  y           Int
  
  color       String?
  imageUrl    String?
  size        Int      @default(1)
  
  hp          Int?
  maxHp       Int?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([roomId])
}

// ====================================
// 🎲 HISTÓRICO DE DADOS
// ====================================

model DiceRoll {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  playerName  String
  
  diceType    String
  quantity    Int      @default(1)
  modifier    Int      @default(0)
  
  result      Int
  rolls       Json
  
  timestamp   DateTime @default(now())
  
  @@index([roomId])
  @@index([timestamp])
}

// ====================================
// 📊 ANALYTICS (Futuro)
// ====================================

model Event {
  id          String   @id @default(cuid())
  userId      String?
  
  eventType   String
  metadata    Json?
  
  timestamp   DateTime @default(now())
  
  @@index([eventType])
  @@index([timestamp])
}
