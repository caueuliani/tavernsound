// apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Global beta budget. Never delete/reset this row during deployment.
model TestBudget {
  id              String   @id
  day             String
  operations      Int      @default(0)
  reservedMinutes Int      @default(0)
  roomId          String?
  endsAt          DateTime?
  participants    Json     @default("[]")
}

// ====================================
// 👤 USUÁRIOS E AUTENTICAÇÃO
// ====================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  avatarUrl     String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  
  // Relações
  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  ownedRooms    Room[]    @relation("RoomOwner")
  roomMembers   RoomMember[]
  sceneAssignments RoomSceneAssignment[]
  diceRolls     DiceRoll[]
  ownedCampaigns Campaign[] @relation("CampaignOwner")
  campaignMemberships CampaignMember[] @relation("CampaignMembership")
  characters    Character[]
  
  @@index([email])
}

// NextAuth: Contas (Google, GitHub, etc)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// NextAuth: Sessões
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// NextAuth: Tokens de verificação
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ====================================
// 💳 ASSINATURAS E PAGAMENTOS
// ====================================

enum SubscriptionTier {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  EXPIRED
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tier            SubscriptionTier   @default(FREE)
  status          SubscriptionStatus @default(ACTIVE)
  
  startDate       DateTime           @default(now())
  endDate         DateTime?
  trialEndsAt     DateTime?
  canceledAt      DateTime?
  
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  
  couponCode      String?
  discountPercent Int?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  invoices        Invoice[]
  
  @@index([userId])
  @@index([status])
}

model Invoice {
  id              String   @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  amount          Int
  currency        String   @default("USD")
  status          String
  
  stripeInvoiceId String?  @unique
  pdfUrl          String?
  
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  
  @@index([subscriptionId])
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int
  maxUses         Int?
  currentUses     Int      @default(0)
  
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  
  @@index([code])
}

// ====================================
// 🏠 SALAS (ROOMS)
// ====================================

model Room {
  id          String   @id
  name        String?  @default("Sala sem nome")
  ownerId     String?
  owner       User?    @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  
  mapUrl      String?
  sceneData   Json?
  gridSize    Int      @default(50)
  mapWidth    Int      @default(20)
  mapHeight   Int      @default(20)
  
  fogOfWarData Json?
  
  isPublic    Boolean  @default(false)
  password    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastActiveAt DateTime @default(now())
  
  tokens      Token[]
  scenes      Scene[]
  sceneAssignments RoomSceneAssignment[]
  members     RoomMember[]
  diceRolls   DiceRoll[]
  sessions    GameSession[]
  
  @@index([ownerId])
  @@index([lastActiveAt])
  @@index([campaignId])
}

// The legacy Room scene fields remain the source of truth until scene switching
// is enabled. Expansion is additive so old clients keep working.
model Scene {
  id String @id
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name String
  position Int
  sceneData Json?
  mapUrl String?
  fogData Json?
  tokens Token[]
  assignments RoomSceneAssignment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, position])
  @@index([roomId])
}

model RoomSceneAssignment {
  roomId String
  userId String
  sceneId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([sceneId])
}

// ====================================
// 📜 CAMPANHAS
// ====================================

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Campaign {
  id            String         @id @default(cuid())
  gameSystemId  String         @default("generic")
  name          String
  description   String?
  status        CampaignStatus @default(ACTIVE)
  
  ownerId       String
  owner         User           @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  inviteCode    String?        @unique
  inviteExpiry  DateTime?
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  rooms         Room[]
  members       CampaignMember[]
  sessions      GameSession[]
  characters    Character[]
  
  @@index([ownerId])
  @@index([inviteCode])
}

// Versioned user-owned character records. Only trusted API flows may update sheets.
model Character {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  gameSystemId String
  sheet        Json
  revision     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([campaignId])
  @@index([userId])
}

model CampaignMember {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation("CampaignMembership", fields: [userId], references: [id], onDelete: Cascade)
  
  role        String   @default("PLAYER")
  joinedAt    DateTime @default(now())
  
  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
}

// ====================================
// 🎮 SESSÕES DE JOGO
// ====================================

model GameSession {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  
  name        String?
  description String?
  notes       String?
  
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  
  participantCount Int  @default(0)
  
  @@index([roomId])
  @@index([campaignId])
  @@index([startedAt])
}

model RoomMember {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  nickname  String
  color     String   @default("#3B82F6")
  
  role      String   @default("PLAYER")
  
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  
  @@index([roomId])
  @@index([userId])
}

// ====================================
// 🎭 TOKENS
// ====================================

enum TokenKind {
  PLAYER
  SCENERY
}

model Token {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  kind        TokenKind @default(PLAYER)
  sceneId     String?
  scene       Scene? @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  
  name        String
  x           Int
  y           Int
  positionX   Float?
  positionY   Float?
  
  color       String?
  imageUrl    String?
  size        Int      @default(1)
  sizeMultiplier Float @default(1)
  
  hp          Int?
  maxHp       Int?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([roomId])
  @@index([sceneId])
}

// ====================================
// 🎲 HISTÓRICO DE DADOS
// ====================================

model DiceRoll {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  playerName  String
  
  diceType    String
  quantity    Int      @default(1)
  modifier    Int      @default(0)
  
  result      Int
  rolls       Json
  
  timestamp   DateTime @default(now())
  
  @@index([roomId])
  @@index([timestamp])
}

// ====================================
// 📊 ANALYTICS (Futuro)
// ====================================

model Event {
  id          String   @id @default(cuid())
  userId      String?
  
  eventType   String
  metadata    Json?
  
  timestamp   DateTime @default(now())
  
  @@index([eventType])
  @@index([timestamp])
}
