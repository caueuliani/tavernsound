# Banco de dados (Supabase, Neon, ou Postgres local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secret compartilhado com o Next.js para assinar o cookie user-session
# Gerar: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32-char-secret"

# Secret para proteger o endpoint /auth/google-login de chamadas externas
# Deve ser o mesmo valor de INTERNAL_API_SECRET no apps/web/.env.local
# Gerar: openssl rand -base64 24
INTERNAL_API_SECRET="change-me-to-a-random-secret"

# URL do frontend (usado no CORS)
FRONTEND_URL="http://localhost:3000"

# Agora RTC (https://console.agora.io)
AGORA_APP_ID="your-agora-app-id"
AGORA_APP_CERTIFICATE="your-agora-app-certificate"

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_BASIC="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."
