# Development only. Create apps/api/.env and replace placeholders.
# Optional outside beta; beta enables scene editing automatically. New maps are stored in PostgreSQL.
LOCAL_MAP_UPLOADS=false
DATABASE_URL=postgresql://tavernsound:CHANGE_ME@localhost:5432/tavernsound
# Same URL locally; Neon uses the direct (non-pooler) URL for migrations.
DIRECT_URL=postgresql://tavernsound:CHANGE_ME@localhost:5432/tavernsound
PORT=3001
# development: local without beta quotas; beta: public access with quotas; production: no beta rules.
APP_ENV=development
# Optional closed-beta caps. Keep unset for defaults (5 seats, 60 aggregate voice-minutes/day).
# BETA_MAX_PARTICIPANTS: 5..12, includes GM. BETA_DAILY_VOICE_MINUTES: 60..1440.
# Voice minutes are GLOBAL across connected participants/rooms, not a room duration.
# E.g. 6 simultaneous voices * 3 hours = ~1080 participant-minutes.
# Confirm Agora allowance before increasing these values.
# BETA_MAX_PARTICIPANTS=6
# BETA_DAILY_VOICE_MINUTES=1080
# Legacy deploys without APP_ENV still use TEST_MODE=true for beta.
FRONTEND_URL=http://localhost:3000
# Use the same random secrets in API and web. Never commit actual values.
SESSION_SECRET=
INTERNAL_API_SECRET=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional until billing is enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
