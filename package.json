{
  "name": "vtt-spatial-audio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run start:dev --workspace=api",
    "build:web": "npm run build --workspace=web",
    "build:api": "npm run build --workspace=api",
    "build": "npm run build:api && npm run build:web",
    "start": "node deploy/start.mjs",
    "test:proxy": "node --test deploy/proxy.test.mjs",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma"
  },
  "engines": { "node": ">=22.12.0 <25" },
  "overrides": {
    "@prisma/config": { "deepmerge-ts": "^8.0.0" }
  },
  "devDependencies": {
    "prisma": "^6.19.2"
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0"
  }
}
